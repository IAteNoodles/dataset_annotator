# Copy this file to `.env` (gitignored) and fill in your values.
# Values here override the YAML config at runtime.

# S3 credentials — also settable from the UI Settings panel (saves to .env).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional: S3-compatible endpoints (MinIO, DigitalOcean Spaces, ...)
AWS_ENDPOINT_URL=

# Optional app overrides (defaults shown)
# DATASET_ANNOTATOR_CONFIG=config/dataset_config.yaml
# DATASET_ANNOTATOR_DB=data/annotator.db
# DATASET_ANNOTATOR_DATASET_PATH=
# AWS_DEFAULT_REGION=us-east-1